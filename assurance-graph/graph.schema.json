{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tyche.institute/schemas/eudiw-assurance-graph-0.1.json",
  "title": "Tyche EUDIW Assurance Graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "graph_id",
    "snapshot_date",
    "claim_boundary",
    "nodes",
    "edges",
    "metrics"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0-research"},
    "graph_id": {"const": "urn:tyche:eudi:assurance-graph:0.1"},
    "snapshot_date": {"format": "date", "type": "string"},
    "claim_boundary": {"minLength": 30, "type": "string"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "label", "status", "properties"],
        "properties": {
          "id": {"pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9._:+-]+$", "type": "string"},
          "type": {
            "enum": [
              "official_source",
              "research_source",
              "research_profile",
              "profile_rule",
              "candidate_objective",
              "test_case",
              "corpus",
              "implementation",
              "evidence_receipt"
            ]
          },
          "label": {"minLength": 1, "type": "string"},
          "status": {"minLength": 1, "type": "string"},
          "properties": {"type": "object"}
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from", "to", "type", "scope"],
        "properties": {
          "id": {"pattern": "^edge:[A-Za-z0-9._:+-]+$", "type": "string"},
          "from": {"type": "string"},
          "to": {"type": "string"},
          "type": {
            "enum": [
              "contains",
              "anchored_in",
              "operationalized_by",
              "realized_by",
              "uses_corpus",
              "evidenced_by",
              "decision_from",
              "consumed_exact_input"
            ]
          },
          "scope": {"minLength": 10, "type": "string"}
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_rules",
        "candidate_objectives",
        "fully_specified_objectives",
        "exact_object_implementations",
        "provenance_receipts",
        "independent_executions"
      ],
      "properties": {
        "profile_rules": {"const": 17},
        "candidate_objectives": {"const": 17},
        "fully_specified_objectives": {"minimum": 0, "type": "integer"},
        "exact_object_implementations": {"minimum": 0, "type": "integer"},
        "provenance_receipts": {"minimum": 0, "type": "integer"},
        "independent_executions": {"minimum": 0, "type": "integer"}
      }
    }
  }
}
